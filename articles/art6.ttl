@prefix gdprkg:  <https://w3id.org/gdprkg#> .
@prefix ex:      <https://w3id.org/gdprkg/data#> .
@prefix eugdpr:  <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  Article 6 — RDF instantiation (ABox)  [PHASE 5, PILOT CASE]
#  ---------------------------------------------------------------
#  Status: 0.1.0-phase5-art6-draft (2026-07-10) — PROVISIONAL,
#  awaiting Zied's review. reviewStatus="draft" on every primary
#  normative unit (here: the six LegalBasis nodes). NOT a validated
#  benchmark.
#
#  Built against ontology/gdpr_kg.ttl (TBox) + validated against
#  ontology/shapes.ttl. Re-derived from the GDPR Art-6 source text
#  (gdpr-info.eu/art-6-gdpr, cross-checked against the ELI/EUR-Lex
#  structure). The provisional Sprint 1-R draft was NOT copied.
#
#  >>> THE CORE FRAMING (read before editing): Article 6 is NOT Article 13.
#  Article 6(1) is a set of LAWFUL BASES (grounds that make processing
#  lawful), NOT a list of disclosure Obligations. The dominant primary
#  normative unit here is gdprkg:LegalBasis, not gdprkg:Obligation.
#  The six bases are gdprkg:LegalBasis INSTANCES (not obligations), each
#  aligned to its DPV-GDPR class eugdpr:A6-1-a…f. 6(1) imposes no
#  disclosure obligation, so NONE is manufactured. (Cf. Art-13
#  surfaced item S9: Art 13's "legal basis"/"consent" mentions are
#  duties to INFORM, not LegalBasis/Consent entities — those entities
#  are canonical shared nodes owned by Art 6 / Art 7. This file mints
#  the Art-6 half.)
#
#  DESIGN DECISIONS APPLIED (frozen CQ resolutions R1-R6):
#   * R4 point-level grounding: each basis is groundedIn its specific
#     6(1) Point (art6-p1-a…f); 6(3)/6(1)-final-subparagraph provisions
#     ground the Condition/Exception nodes attached to the bases.
#   * canonical / shared: the six bases are ARTICLE-NEUTRAL nodes
#     (ex:basis-*), the same discipline as the step-zero ex:concept-*
#     canonicalisation. Art 13 wires INTO these nodes' grounding
#     provisions (§ cross-article payload, below) and Art 7 will later
#     extend the consent story. Do NOT create article-local copies.
#   * R6 out-of-scope refs (Art 9, 10, 23) -> gdprkg:ReferencedProvision
#     stubs / not populated. Union/MS law is represented as a minimal
#     external-reference stub (SURFACE-E).
#
#  IN SCOPE this pass: 6(1)(a)-(f) as six LegalBasis nodes; the 6(1)
#  final-subparagraph public-authority carve-out on (f) (Exception);
#  the 6(1)(f) balancing test (Condition); 6(3) union/MS-law
#  qualification on (c) and (e) (Condition). 6(4) further-processing
#  compatibility test is DEFERRED (SURFACE-B). 6(2) is a meta-provision
#  (SURFACE-D), represented but not populated.
#
#  >>> ITEMS SURFACED FOR REVIEW (do NOT treat as settled) are collected
#      in articles/art6_surfaced_items.md (SURFACE-A…G) and the report.
#      Key ones are flagged inline below with  #!SURFACE .
#################################################################

<https://w3id.org/gdprkg/data/art6>
    a owl:Ontology ;
    rdfs:label "GDPR Article 6 instance graph (ABox)"@en ;
    owl:versionInfo "0.1.0-phase5-art6-draft (2026-07-10) — provisional, awaiting review. Six canonical LegalBasis nodes (DPV-GDPR aligned, GDPRtEXT-grounded, provenance + reviewStatus=draft); 6(1)(f) balancing Condition; 6(1) final-subparagraph public-authority Exception; 6(3) union/MS-law Condition on (c)/(e). Cross-article: Art-13 Art-6 stubs rewired to these bases' grounding provisions." ;
    rdfs:comment "Pilot instantiation of GDPR Article 6 against the gdprkg TBox. Six point-level LegalBasis nodes (6(1)(a)-(f)), each DPV-GDPR-aligned (eugdpr:A6-1-a…f) and GDPRtEXT-grounded; a 6(1)(f) balancing Condition and a 6(1)-final-subparagraph public-authority Exception attached to the legitimate-interests basis; a shared 6(3) Condition (Union/MS law) attached to the legal-obligation and public-task bases; one shared ProvenanceRecord. First genuine cross-article integration test: Art-13's Art-6 references are wired to these bases' grounding provisions. reviewStatus=draft throughout."@en ;
    owl:imports <https://w3id.org/gdprkg> .

#################################################################
#  1 — LEGAL-SOURCE CHAIN  (Regulation -> Article -> Paragraph -> Point)
#  ex:gdpr is re-declared (same canonical node as in art13.ttl) so this
#  file is self-contained when loaded standalone; when loaded together
#  with art13.ttl, ex:gdpr accrues hasArticle art13 AND art6.
#  #!SURFACE exact GDPRtEXT fragment IRIs + ELI sub-Article subdivisions
#  are not yet pinned (same S10 follow-up as Art 13).
#################################################################

ex:gdpr a gdprkg:Regulation ;
    rdfs:label "Regulation (EU) 2016/679 (GDPR)"@en ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2016/679/oj> ;
    gdprkg:hasArticle ex:art6 .

ex:art6 a gdprkg:Article ;
    rdfs:label "Article 6"@en ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2016/679/art_6> ;
    gdprkg:workingTextSource "https://gdpr-info.eu/art-6-gdpr/"^^xsd:anyURI ;
    gdprkg:hasParagraph ex:art6-p1 , ex:art6-p2 , ex:art6-p3 , ex:art6-p4 .

# --- Paragraph 1 (chapeau) + its six lettered points ---
ex:art6-p1 a gdprkg:Paragraph ; rdfs:label "Article 6(1)"@en ;
    skos:note "Processing shall be lawful only if and to the extent that at least one of the following applies:"@en ;
    gdprkg:hasPoint ex:art6-p1-a , ex:art6-p1-b , ex:art6-p1-c , ex:art6-p1-d , ex:art6-p1-e , ex:art6-p1-f , ex:art6-p1-final .

ex:art6-p1-a a gdprkg:Point ; rdfs:label "Article 6(1)(a)"@en ;
    skos:note "the data subject has given consent to the processing of his or her personal data for one or more specific purposes;"@en .
ex:art6-p1-b a gdprkg:Point ; rdfs:label "Article 6(1)(b)"@en ;
    skos:note "processing is necessary for the performance of a contract to which the data subject is party or in order to take steps at the request of the data subject prior to entering into a contract;"@en .
ex:art6-p1-c a gdprkg:Point ; rdfs:label "Article 6(1)(c)"@en ;
    skos:note "processing is necessary for compliance with a legal obligation to which the controller is subject;"@en .
ex:art6-p1-d a gdprkg:Point ; rdfs:label "Article 6(1)(d)"@en ;
    skos:note "processing is necessary in order to protect the vital interests of the data subject or of another natural person;"@en .
ex:art6-p1-e a gdprkg:Point ; rdfs:label "Article 6(1)(e)"@en ;
    skos:note "processing is necessary for the performance of a task carried out in the public interest or in the exercise of official authority vested in the controller;"@en .
ex:art6-p1-f a gdprkg:Point ; rdfs:label "Article 6(1)(f)"@en ;
    skos:note "processing is necessary for the purposes of the legitimate interests pursued by the controller or by a third party, except where such interests are overridden by the interests or fundamental rights and freedoms of the data subject which require protection of personal data, in particular where the data subject is a child."@en .
# The 6(1) FINAL SUBPARAGRAPH (public-authority carve-out on point (f)).
# #!SURFACE-F (typing): it is a sub-PARAGRAPH, not a lettered point, but the TBox's only
# leaf-level LegalProvision subclass is gdprkg:Point, so it is typed gdprkg:Point (and linked
# via hasPoint) as the least-bad existing type. Alternative: a dedicated Subparagraph class
# (would be a NEW class -> deferred, not minted this pass).
ex:art6-p1-final a gdprkg:Point ; rdfs:label "Article 6(1), final subparagraph"@en ;
    skos:note "Point (f) of the first subparagraph shall not apply to processing carried out by public authorities in the performance of their tasks."@en .

# --- Paragraph 2 (Member-State margin) — META, represented but NOT populated (SURFACE-D) ---
# 6(2) is a meta-provision about national law adapting (c)/(e); it establishes no directly
# modellable basis, so no normative unit is attached. Kept in the source tree for coverage.
ex:art6-p2 a gdprkg:Paragraph ; rdfs:label "Article 6(2)"@en ;
    skos:note "Member States may maintain or introduce more specific provisions to adapt the application of the rules of this Regulation with regard to processing for compliance with points (c) and (e) of paragraph 1 ... including for other specific processing situations as provided for in Chapter IX."@en .

# --- Paragraph 3 (basis for (c)/(e) must be in Union/MS law) ---
ex:art6-p3 a gdprkg:Paragraph ; rdfs:label "Article 6(3)"@en ;
    skos:note "The basis for the processing referred to in point (c) and (e) of paragraph 1 shall be laid down by Union law or Member State law to which the controller is subject. The purpose of the processing shall be determined in that legal basis ... The Union or the Member State law shall meet an objective of public interest and be proportionate to the legitimate aim pursued."@en .

# --- Paragraph 4 (further-processing compatibility test) — DEFERRED (SURFACE-B) ---
# 6(4) introduces a compatibility TEST with factors (a)-(e) and cross-refs Art 9/10/23; it is a
# new construct (a test/procedure carrying a controller duty), bundled with deferred item I9 for a
# scoped follow-up. Represented in the source tree but NOT populated this pass. Its factor points
# (a)-(e) are deliberately NOT minted.
ex:art6-p4 a gdprkg:Paragraph ; rdfs:label "Article 6(4)"@en ;
    skos:note "Where the processing for a purpose other than that for which the personal data have been collected is not based on the data subject's consent or on a Union or Member State law ..., the controller shall, in order to ascertain whether processing for another purpose is compatible ..., take into account, inter alia: (a) any link between the purposes ...; (b) the context ...; (c) the nature of the personal data ...; (d) the possible consequences ...; (e) the existence of appropriate safeguards ... (DEFERRED this pass — SURFACE-B)."@en .

#################################################################
#  1b — OUT-OF-SCOPE / EXTERNAL REFERENCED PROVISIONS  — stubs, never populated
#  Art 9, 10, 23 are cross-referenced by Art 6(4) (deferred) and stay R6 stubs.
#  ex:ref-union-ms-law is a MINIMAL EXTERNAL-REFERENCE stub for "Union or Member
#  State law" (6(3)) — SURFACE-E: this reuses gdprkg:ReferencedProvision as a
#  generic external-reference marker even though Union/MS law is NOT a GDPR provision.
#  Alternatives (a dedicated external-law node type; a note only) are flagged, not decided.
#################################################################

ex:ref-union-ms-law a gdprkg:ReferencedProvision ;
    rdfs:label "Union or Member State law (external legal basis referenced by Art 6(3); NOT a GDPR provision) [SURFACE-E]"@en .

#################################################################
#  2 — PROVENANCE (one shared record for the single Art-6 mapping pass)
#  Parallel to the Art-13 pattern (art13.ttl S8): one ProvenanceRecord for all
#  Art-6 primary units (the six bases), produced by one mapping activity.
#  ex:agent-mapper is re-declared (same shared canonical agent as art13.ttl).
#################################################################

ex:prov-art6 a gdprkg:ProvenanceRecord ; rdfs:label "Provenance: Art-6 initial mapping (draft)"@en ;
    prov:wasGeneratedBy ex:act-art6-mapping ;
    prov:wasAttributedTo ex:agent-mapper .
ex:act-art6-mapping a gdprkg:MappingReviewActivity ; rdfs:label "Art-6 extraction/mapping activity"@en ;
    prov:wasAssociatedWith ex:agent-mapper .
ex:agent-mapper a gdprkg:Reviewer ; rdfs:label "Mapping agent (pending human/legal sign-off)"@en .

#################################################################
#  3 — CONDITIONS + EXCEPTION on the bases (grounded; inherit provenance via parent basis)
#  #!SURFACE-F (domain part RESOLVED 2026-07-12 — TIGHTENED, not widened): these are attached to
#  LegalBasis nodes via gdprkg:appliesIf (Condition) and gdprkg:hasException (Exception). Those two
#  properties now carry rdfs:domain gdprkg:PrimaryNormativeUnit (tightened from NormativeElement,
#  Zied's SURFACE-F resolution, 2026-07-12 — see CLAUDE.md decision log), so these edges entail each
#  such basis is a PrimaryNormativeUnit (which it already is — intended), NOT a NormativeElement
#  (the earlier accidental entailment). The frozen CQ-B2/CQ-B4 links sit on the basis as required.
#  STILL OPEN (F2 residual, ledger carry f2-domain-family): notApplicableIf / hasLegalEffect keep
#  rdfs:domain NormativeElement — if a LegalBasis ever carries either, the accidental entailment
#  recurs. Construct choice (Exception vs scoping-Condition, below) also remains a flagged call.
#################################################################

# 6(1)(f) balancing test (legitimate interests not overridden ...). Attached to basis-legitimate-interests.
# #!SURFACE-F child-specific clause ("in particular where the data subject is a child") is a legal
# nuance kept inside the Condition label/grounding text, NOT over-modelled as a sub-structure.
ex:cond-6-1-f-balancing a gdprkg:Condition ;
    rdfs:label "the legitimate interests are not overridden by the interests or fundamental rights and freedoms of the data subject (in particular where the data subject is a child)"@en ;
    gdprkg:groundedIn ex:art6-p1-f .

# 6(1) final subparagraph — public-authority carve-out on point (f). Attached to basis-legitimate-interests.
# #!SURFACE-F Exception vs scoping-Condition: modelled as an Exception (parallel to the shared 13(4)
# Exception pattern) because it DEFEATS the availability of (f) for public authorities. Whether an
# Exception or a scoping-Condition is the right construct is a modelling call — flagged, not decided.
ex:exc-6-1-f-public-authority a gdprkg:Exception ;
    rdfs:label "point (f) does not apply to processing carried out by public authorities in the performance of their tasks (Art 6(1), final subparagraph)"@en ;
    gdprkg:groundedIn ex:art6-p1-final .

# 6(3) — the basis for (c) and (e) must be laid down in Union or Member-State law.
# ONE shared Condition attached to BOTH basis-legal-obligation and basis-public-task (grounding is
# identical, art6-p3, for both — node-sharing discipline, cf. the shared 13(4) Exception). It
# references the external Union/MS-law stub via referencesProvision (Condition is a NormativeElement,
# so referencesProvision's domain is satisfied cleanly). #!SURFACE-E (external reference) / see the
# node-sharing note above.
ex:cond-6-3-basis-in-union-or-ms-law a gdprkg:Condition ;
    rdfs:label "the basis for the processing is laid down in Union law or Member State law to which the controller is subject (Art 6(3))"@en ;
    gdprkg:groundedIn ex:art6-p3 ;
    gdprkg:referencesProvision ex:ref-union-ms-law .

#################################################################
#  4 — THE SIX LAWFUL BASES (6(1)(a)-(f)) — canonical, article-neutral LegalBasis nodes
#  Each:  typed with its specific TBox subclass gdprkg:LegalBasis<X> (which is
#         rdfs:subClassOf gdprkg:LegalBasis AND owl:equivalentClass eugdpr:A6-1-x),
#         AND additionally asserted  a eugdpr:A6-1-x  so the DPV-GDPR alignment is
#         explicit at instance level (redundant-but-explicit under the equivalence);
#         groundedIn its 6(1) Point;  hasProvenance ex:prov-art6 ;  reviewStatus "draft".
#  These are the SHARED nodes Art 13 wires into (via their grounding provisions) and
#  Art 7 will extend. Do NOT create article-local copies.
#################################################################

ex:basis-consent a gdprkg:LegalBasisConsent , eugdpr:A6-1-a ;
    rdfs:label "Lawful basis: consent (Art 6(1)(a))"@en ;
    gdprkg:groundedIn ex:art6-p1-a ;
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .
    #!SURFACE-G the Art-7 CONSENT ENTITY (gdprkg:Consent, ≡ gconsent:Consent) is a DISTINCT,
    # grounded primary unit whose grounding target is Article 7 (not yet instantiated). It is NOT
    # minted here (a placeholder would violate the grounding/provenance invariant — same logic as
    # Art-13 SURFACE-7). The basis-consent ↔ consent-entity link and the canonical concept-consent
    # node are DEFERRED to Art-7 instantiation (forward reference recorded). The "one or more
    # specific purposes" clause is captured in the art6-p1-a skos:note; a basis→Purpose link is NOT
    # drawn (no existing property supports it; a new one would need flagging — SURFACE-G).

ex:basis-contract a gdprkg:LegalBasisContract , eugdpr:A6-1-b ;
    rdfs:label "Lawful basis: performance of a contract (Art 6(1)(b))"@en ;
    gdprkg:groundedIn ex:art6-p1-b ;
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .

ex:basis-legal-obligation a gdprkg:LegalBasisLegalObligation , eugdpr:A6-1-c ;
    rdfs:label "Lawful basis: compliance with a legal obligation (Art 6(1)(c))"@en ;
    gdprkg:groundedIn ex:art6-p1-c ;
    gdprkg:appliesIf ex:cond-6-3-basis-in-union-or-ms-law ;   # 6(3): basis must be in Union/MS law (SURFACE-F domain entailment)
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .

ex:basis-vital-interests a gdprkg:LegalBasisVitalInterests , eugdpr:A6-1-d ;
    rdfs:label "Lawful basis: vital interests (Art 6(1)(d))"@en ;
    gdprkg:groundedIn ex:art6-p1-d ;
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .

ex:basis-public-task a gdprkg:LegalBasisPublicInterest , eugdpr:A6-1-e ;
    rdfs:label "Lawful basis: public interest / official authority (Art 6(1)(e))"@en ;
    gdprkg:groundedIn ex:art6-p1-e ;
    gdprkg:appliesIf ex:cond-6-3-basis-in-union-or-ms-law ;   # 6(3): basis must be in Union/MS law (SURFACE-F domain entailment)
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .

ex:basis-legitimate-interests a gdprkg:LegalBasisLegitimateInterests , eugdpr:A6-1-f ;
    rdfs:label "Lawful basis: legitimate interests (Art 6(1)(f))"@en ;
    gdprkg:groundedIn ex:art6-p1-f ;
    gdprkg:appliesIf ex:cond-6-1-f-balancing ;                 # 6(1)(f) balancing test (SURFACE-F)
    gdprkg:hasException ex:exc-6-1-f-public-authority ;        # 6(1) final subpara public-authority carve-out (SURFACE-F)
    gdprkg:hasProvenance ex:prov-art6 ; gdprkg:reviewStatus "draft" .

#################################################################
#  END — 6 LegalBasis nodes (6(1)(a)-(f)); 2 Conditions (6(1)(f) balancing,
#  6(3) union/MS-law shared over (c)+(e)); 1 Exception (6(1) final subpara);
#  1 external-reference stub; 1 shared ProvenanceRecord.
#  6(2) meta + 6(4) compatibility test are present-but-unpopulated (SURFACE-D / SURFACE-B).
#################################################################
