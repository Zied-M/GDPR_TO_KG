    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

ex:obl-art14-2-d-withdraw-consent a gdprkg:Obligation ;
    rdfs:label "Inform of the existence of the right to withdraw consent at any time, without affecting the lawfulness of processing based on consent before its withdrawal (Art 14(2)(d))"@en ;
    gdprkg:groundedIn ex:art14-p2-d ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:hasTimeLimit "within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed" ;
    gdprkg:appliesIf ex:cond-14-2-d-consent-basis ,
                     ex:cond-14-3-b-first-communication , ex:cond-14-3-c-first-disclosure ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

ex:obl-art14-2-e-lodge-complaint a gdprkg:Obligation ;
    rdfs:label "Inform of the right to lodge a complaint with a supervisory authority (Art 14(2)(e))"@en ;
    gdprkg:groundedIn ex:art14-p2-e ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:referencesActor ex:actor-supervisory-authority ;
    gdprkg:hasTimeLimit "within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed" ;
    gdprkg:appliesIf ex:cond-14-3-b-first-communication , ex:cond-14-3-c-first-disclosure ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

# 14(2)(f) FIRST half (T3-E(i) split 1/2). NO Art-13 counterpart. The data SOURCE is represented
# via gdprkg:referencesActor -> ex:actor-personal-data-source (T3-E(ii)), NOT via disclosesConcept.
ex:obl-art14-2-f-source a gdprkg:Obligation ;
    rdfs:label "Provide from which source the personal data originate (Art 14(2)(f), item 1/2)"@en ;
    gdprkg:groundedIn ex:art14-p2-f ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:referencesActor ex:actor-personal-data-source ;
    gdprkg:hasTimeLimit "within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed" ;
    gdprkg:appliesIf ex:cond-14-3-b-first-communication , ex:cond-14-3-c-first-disclosure ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

# 14(2)(f) SECOND half (T3-E(i) split 2/2) — the "if applicable" publicly-accessible clause.
ex:obl-art14-2-f-publicly-accessible a gdprkg:Obligation ;
    rdfs:label "Provide, if applicable, whether the personal data came from publicly accessible sources (Art 14(2)(f), item 2/2)"@en ;
    gdprkg:groundedIn ex:art14-p2-f ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:referencesActor ex:actor-personal-data-source ;
    gdprkg:hasTimeLimit "within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed" ;
    gdprkg:appliesIf ex:cond-14-2-f-publicly-accessible-applicable ,
                     ex:cond-14-3-b-first-communication , ex:cond-14-3-c-first-disclosure ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

ex:obl-art14-2-g-automated-decision a gdprkg:Obligation ;
    rdfs:label "Inform of the existence of automated decision-making incl. profiling, with meaningful information about the logic involved, the significance and the envisaged consequences (Art 14(2)(g))"@en ;
    gdprkg:groundedIn ex:art14-p2-g ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:referencesProvision ex:ref-art22 ;   # REUSED from art13.ttl (Art 22(1) and (4))
    gdprkg:hasTimeLimit "within a reasonable period after obtaining the personal data, but at the latest within one month, having regard to the specific circumstances in which the personal data are processed" ;
    gdprkg:appliesIf ex:cond-14-3-b-first-communication , ex:cond-14-3-c-first-disclosure ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

# ---------- Paragraph 4 (1 obligation; grounded at Paragraph level per R4) ----------
# Direct parallel to ex:obl-art13-3-further-processing-info. NOTE: 14(3)'s timing governs
# "the information referred to in paragraphs 1 and 2" only, so this duty carries NEITHER the
# 14(3)(a) hasTimeLimit NOR the 14(3)(b)/(c) trigger Conditions — it has its own "prior to
# that further processing" timing. SURFACE-14-EXEC-3.
ex:obl-art14-4-further-processing-info a gdprkg:Obligation ;
    rdfs:label "Provide information on the new purpose and any relevant further information referred to in paragraph 2, prior to further processing (Art 14(4))"@en ;
    gdprkg:groundedIn ex:art14-p4 ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:disclosedToDataSubject ex:actor-data-subject ;
    gdprkg:appliesIf ex:cond-14-4-further-processing , ex:cond-14-4-prior ;
    gdprkg:hasException ex:exc-art14-5-a-already-has-info , ex:exc-art14-5-b-impossible-disproportionate ,
                        ex:exc-art14-5-c-laid-down-by-law , ex:exc-art14-5-d-professional-secrecy ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

# ---------- Paragraph 5 (1 obligation — the 24th; T3-C, Zied 2026-08-04) ----------
# 14(5)(b)'s affirmative second sentence, modelled as an Obligation and grounded in the SAME
# Point (ex:art14-p5-b) as ex:exc-art14-5-b-impossible-disproportionate. That shared grounding
# Point IS the wiring that makes it reachable FROM the exemption ground, so the frozen question
# CQ-A6 ("when the impossible/disproportionate-effort exemption applies, what obligation remains
# in force?") returns it. It is the SAME join idiom as CQ-C5x (shared-grounding-Point join,
# SURFACE-C, 2026-07-10) — deliberately, because no exception->obligation property exists and
# minting one would be a TBox change this unit is not authorized to make. SURFACE-14-EXEC-6.
#
# It carries NO hasException (it arises BECAUSE ground (b) applies — defeating it with the very
# exemption that triggers it would be incoherent), NO hasTimeLimit, and NO disclosedToDataSubject
# (its duty is "appropriate measures … including making the information PUBLICLY AVAILABLE",
# which is not a disclosure to the data subject). SURFACE-14-EXEC-7.
#
# ⚠ LEGALLY UNCORROBORATED (brief §2.5): asserting a duty that arises BECAUSE an exemption
# applies is a legal characterisation. The MODELLING decision is Zied's and taken; the DOCTRINAL
# confirmation is not. Carried to the finished-work legal review alongside I8.
ex:obl-art14-5-b-protective-measures a gdprkg:Obligation ;
    rdfs:label "Take appropriate measures to protect the data subject's rights and freedoms and legitimate interests, including making the information publicly available, where the 14(5)(b) exemption applies (Art 14(5)(b), second sentence)"@en ;
    gdprkg:groundedIn ex:art14-p5-b ;
    gdprkg:imposesObligationOn ex:actor-controller ;
    gdprkg:hasProvenance ex:prov-art14 ; gdprkg:reviewStatus "draft" .

#################################################################
#  END — 24 Obligations (P1:9, P2:13, P3:0, P4:1, P5:1);
#  12 Conditions (2 node-shared over 22 duties each: cond-14-3-b, cond-14-3-c);
#  4 Exceptions, each node-shared over 23 obligations;
#  22 hasTimeLimit; 23 disclosedToDataSubject; 6 disclosesConcept;
#  4 referencesActor; 11 referencesProvision; 1 shared ProvenanceRecord.
#  MINTS: ex:concept-data-category, ex:actor-personal-data-source, ex:ref-art89.
#  NO TBox change. NO SHACL change. NO notApplicableIf. NO hasLegalEffect.
#  NO Permission / grantsPermissionTo (Art 14 grants no discretionary power).
#################################################################

#################################################################
#  WORK ORDER F (2026-09-06) - THE COLLECTION-SOURCE TRIGGER
#  ---------------------------------------------------------------
#  ex:cond-collected-from-data-subject is the CANONICAL SHARED NODE declared in art13.ttl
#  (the ex:concept-* precedent: Art 14 references the SAME node, it does NOT create a local
#  copy). Re-asserting its rdf:type here is the same convention the canonical concept nodes
#  use at the "Domain layer" block above, and it keeps this file independently loadable; the
#  triple is IDENTICAL to art13.ttl's and dedups in the union.
#
#  THE NEGATIVE EDGE. 14(1) states its trigger as "Where personal data have NOT been obtained
#  from the data subject". Zied's model, decided 2026-09-06: that is the SAME FACT as 13(1)'s
#  in opposite polarity (legal reading, citing CJEU), so Art 14's duties attach to the shared
#  node with gdprkg:notApplicableIf rather than to a separate Art-14 condition of their own.
#
#  WHAT THIS ASSERTS AND WHAT IT DOES NOT. It asserts MUTUAL EXCLUSIVITY only: where the data
#  WERE collected from the data subject, these duties do not apply. It does NOT assert
#  EXHAUSTIVENESS and licenses NO inference that Article 14 DOES apply when the condition is
#  false - that is the closed-world step refused at Art 46(3), and it is refused here too.
#
#  GROUNDING. The node is grounded in BOTH chapeaux; this file asserts the art14-p1 leg, so
#  Article 14's own chapeau is recorded as a source of the fact it states. FIRST node in the
#  project with two groundedIn edges (permitted: minCount 1, no maxCount).
#
#  SCOPE. referencesProvision onto 14(1)-(4), matching how all four 14(5) exceptions declare
#  theirs. ex:obl-art14-5-b-protective-measures is therefore OUTSIDE the set - grounded in
#  art14-p5-b, outside the declared scope - exactly as it already sits outside all four 14(5)
#  bearer sets, with no exclusion list. It remains the only Obligation in either file with no
#  condition edge at all, which is correct: it arises BECAUSE ground (b) applies.
#
#  RECORDED NON-COVERAGE - the 23 edges below are INVISIBLE to CQ-A3 (which keys on appliesIf)
#  and to CQ-C6's inherited branch (which enumerates appliesIf|hasException). NEITHER FROZEN
#  QUERY WAS WIDENED HERE and no edge was re-pointed to appliesIf to move a count. The shared
#  node still resolves under CQ-C6 via the 21 Art-13 appliesIf edges, so NO NODE IS LEFT
#  UNPROVENANCED - this is NOT a second instance of the Art-46 EXEC-9 finding, where the gate
#  condition had no provenance path at all. Zied has ruled the CQ encoding mis-models its own
#  stated question and may be corrected; that is a SEPARATE unit, deliberately not this one.
#################################################################

ex:cond-collected-from-data-subject a gdprkg:Condition ;   # SHARED canonical node with art13.ttl (not a copy)
    gdprkg:groundedIn ex:art14-p1 ;
    gdprkg:referencesProvision ex:art14-p1 , ex:art14-p2 , ex:art14-p3 , ex:art14-p4 .

ex:obl-art14-1-a-controller-identity gdprkg:notApplicableIf ex:cond-collected-from-data-subject .
